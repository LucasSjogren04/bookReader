{
  "manifest_version": 3,
  "name": "Shelf — Book Reader",
  "version": "1.0.0",
  "description": "Drop EPUB, AZW3, MOBI, PDF, FB2, FBZ, CBZ, TXT and more into a local library and read them with smart, real-time pagination.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Shelf",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["unlimitedStorage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
